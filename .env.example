# Database Connection
# Provide your MongoDB Atlas or remote connection URI:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/tutorhq?retryWrites=true&w=majority"
# Or alternatively:
# MONGODB_GLOBAL_URI="mongodb+srv://..."
# MONGODB_LOCAL_URI="mongodb://localhost:27017/tutorhq"

# Session Security
# 32+ character random secret key for HMAC SHA256 session token generation:
SESSION_SECRET="your-strong-random-session-secret"
